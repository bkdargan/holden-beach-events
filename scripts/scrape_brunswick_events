import json
import requests
from bs4 import BeautifulSoup
from urllib.parse import urljoin

BASE_URL = "https://www.ncbrunswick.com"
CALENDAR_URL = (
    "https://www.ncbrunswick.com/events/"
    "?view=list&sort=date"
)

session = requests.Session()

session.headers.update(
    {
        "User-Agent": "Mozilla/5.0"
    }
)

event_urls = set()

#
# Collect event links
#

skip = 0

while True:

    page_url = (
        f"{CALENDAR_URL}&skip={skip}"
    )

    print(
        f"Checking {page_url}"
    )

    response = session.get(
        page_url,
        timeout=30
    )

    response.raise_for_status()

    soup = BeautifulSoup(
        response.text,
        "html.parser"
    )

    page_links = set()

    for a in soup.find_all(
        "a",
        href=True
    ):

        href = a["href"]

        if (
            "/events/" in href
            and href != "/events/"
        ):

            page_links.add(
                urljoin(
                    BASE_URL,
                    href
                )
            )

    new_links = (
        page_links
        - event_urls
    )

    if not new_links:
        break

    event_urls.update(
        new_links
    )

    skip += 12

print(
    f"Found {len(event_urls)} event links"
)

events = []

#
# Scrape event pages
#

for url in sorted(event_urls):

    try:

        print(
            f"Scraping {url}"
        )

        response = session.get(
            url,
            timeout=30
        )

        response.raise_for_status()

        soup = BeautifulSoup(
            response.text,
            "html.parser"
        )

        title = ""

        h1 = soup.find("h1")

        if h1:
            title = h1.get_text(
                " ",
                strip=True
            )

        paragraphs = []

        for p in soup.find_all("p"):

            text = p.get_text(
                " ",
                strip=True
            )

            if len(text) > 20:
                paragraphs.append(
                    text
                )

        description = (
            paragraphs[0]
            if paragraphs
            else ""
        )

        events.append(
            {
                "title": title,
                "date_time": "",
                "location": "",
                "description": description,
                "url": url
            }
        )

    except Exception as e:

        print(
            f"Failed {url}: {e}"
        )

with open(
    "brunswick_events.json",
    "w",
    encoding="utf-8"
) as f:

    json.dump(
        events,
        f,
        indent=2,
        ensure_ascii=False
    )

print(
    f"Saved {len(events)} events"
)
